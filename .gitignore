# Ignore rules for the public release-snapshot mirror.
#
# Deliberately NOT the work repo's .gitignore: that one names internal-only
# working dirs (`backlog/`, `.worktrees/`, `tmp/`, `.state/`) and a dev script
# that is stripped from this mirror, i.e. internal process vocabulary on a
# public page. This keeps only what a reader who clones the mirror and runs
# `python3 tools/convert.py . --out build/...` actually needs.
#
# Stored here without the leading dot (like skills/init/templates/gitignore) so
# it cannot act as a real .gitignore inside the work repo; the publish step
# copies it to `.gitignore`.

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.pyc
.pytest_cache/

# Environment
.env
.env.local

# Extension build artefacts (regenerated by tools/convert.py)
build/
.qwen/
